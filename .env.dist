# BotFather'dan olingan token
BOT_TOKEN=123456:Your-TokEn_ExaMple
# Adminlarning Telegram ID lari (vergul bilan). Arizalar shu odamlarga keladi.
ADMINS=123456,654321
USE_REDIS=False
# Majburiy obuna: guruh/kanal @username, https://t.me/... havolasi yoki ID si (-100...), bir nechtasi vergul bilan.
# Bot o'sha guruhda ADMIN bo'lishi shart. Bo'sh bo'lsa, obuna so'ralmaydi.
REQUIRED_CHATS=

POSTGRES_USER=postgres
# Serverda albatta murakkab parol qo'ying!
POSTGRES_PASSWORD=postgres_pass12345
POSTGRES_DB=maqola_bot
# Bot kompyuterda (PyCharm) ishlaganda — kompyuterdagi PostgreSQL.
# Docker'da (serverda) docker-compose.yml bularni o'zi pg_database:5432 ga almashtiradi.
DB_HOST=localhost
DB_PORT=5432

# REDIS_HOST=redis_cache
# REDIS_PORT=6388
# REDIS_DB=1
# REDIS_PASSWORD=someredispass


#WEBHOOK_EXPOSE=8001
#WEBHOOK_APP_NAME=webhook

# Mini App havolalari (https). Bo'sh bo'lsa tugma chiqmaydi.
URL_BLOG=
# Xizmatlarning "Xizmat haqida batafsil" sahifalari
URL_SCOPUS=
URL_WOS=
URL_OAK=
URL_DISS=
URL_HIRSH=
URL_CONF=

# Elsevier Scopus API kaliti (https://dev.elsevier.com)
SCOPUS_API_KEY=
