# BotFather'dan olingan token
BOT_TOKEN=123456:Your-TokEn_ExaMple
# Adminlarning Telegram ID lari (vergul bilan). Arizalar shu odamlarga keladi.
ADMINS=123456,654321
USE_REDIS=False

POSTGRES_USER=postgres
# Serverda albatta murakkab parol qo'ying!
POSTGRES_PASSWORD=postgres_pass12345
POSTGRES_DB=maqola_bot
# Bot kompyuterda (PyCharm) ishlaganda — kompyuterdagi PostgreSQL.
# Docker'da (serverda) docker-compose.yml bularni o'zi pg_database:5432 ga almashtiradi.
DB_HOST=localhost
DB_PORT=5432

